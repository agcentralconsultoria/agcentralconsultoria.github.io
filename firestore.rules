rules_version = '2';
// Regras do CRM (Equipe). Resumo:
// - Angelo (administrador) le e grava tudo do CRM.
// - Funcionario so le a propria visao filtrada (equipeVisao/{uid}), que o
//   servidor monta com os pacientes e areas liberados. Ele nunca grava direto:
//   toda gravacao dele passa pelo servidor (equipeSalvar), que confere a permissao.
// - Quem nao e nem um nem outro nao le nem grava nada.
// O servidor (Cloud Functions) nao passa por estas regras.
service cloud.firestore {
  match /databases/{database}/documents {
    // So conta como logado quem entrou com senha E codigo do Google Authenticator.
    // Sem o codigo (ou com sessao antiga, de antes do Authenticator), o banco nao entrega nada.
    function logado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_second_factor == 'totp';
    }
    function admin() { return logado() && request.auth.uid == 'uLicObTjbnZS5D3uIRKHLFlxhcO2'; }
    function membroAtivo() {
      return logado()
        && exists(/databases/$(database)/documents/equipe/$(request.auth.uid))
        && get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data.ativo == true;
    }

    match /crmData/{docId} {
      allow read, write: if admin();
      // marcas pessoais da "Atencao de hoje" de cada um
      allow read, write: if membroAtivo() && docId == 'atencaoHoje_' + request.auth.uid;
    }

    match /equipe/{uid} {
      allow read: if admin() || (logado() && request.auth.uid == uid);
      allow write: if admin();
    }

    match /equipeGrupos/{gid} {
      allow read, write: if admin();
    }

    match /equipeVisao/{uid}/dados/{nome} {
      allow read: if logado() && request.auth.uid == uid && membroAtivo();
      allow write: if false;
    }

    match /auditoria/{id} {
      allow read, create: if admin();
      // funcionario so registra log no proprio nome (ex: check da Atencao de hoje);
      // nunca le, altera nem apaga log nenhum
      allow create: if membroAtivo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.funcionario == true;
      allow update, delete: if false;
    }

    // Automacao (so o Angelo). O CRM cria o pedido; so o servidor (vigia) muda andamento e resultado.
    match /automacaoPedidos/{id} {
      allow read: if admin();
      allow create: if admin()
        && request.resource.data.keys().hasOnly(['tipo', 'modo', 'status', 'criadoEm', 'criadoPor'])
        && request.resource.data.tipo in ['checkins', 'fotos', 'treinos', 'engajamento', 'todas']
        && request.resource.data.modo in ['previa', 'direto']
        && request.resource.data.status == 'pendente'
        && request.resource.data.criadoEm is number
        && request.resource.data.criadoPor == request.auth.uid;
      // Cancelar: o Angelo cancela pedido na fila (pendente -> cancelado) ou pede pra parar o que
      // esta executando (so liga o aviso cancelarSolicitado; o vigia e quem finaliza).
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finalizadoEm', 'cancelarSolicitado'])
        && request.resource.data.cancelarSolicitado == true
        && ((resource.data.status == 'pendente' && request.resource.data.status == 'cancelado' && request.resource.data.finalizadoEm is number)
            || (resource.data.status == 'executando' && request.resource.data.status == 'executando'));
      allow delete: if false;
    }
    match /automacaoResumo/{id} {
      allow read: if admin();
      allow write: if false;
    }
    match /automacaoVigia/{id} {
      allow read: if admin();
      allow write: if false;
    }

    // calendarEvents, calendarSync, syncTokens, syncBatches etc.: so o servidor.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
